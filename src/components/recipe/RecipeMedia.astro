---
import type { CategorySlug } from '../../data/categories';
import { getCategory } from '../../data/categories';

interface Props {
  title: string;
  category: CategorySlug;
  image?: string;
  eager?: boolean;
}
const { title, category, image, eager = false } = Astro.props;
---

<div class="recipe-media" data-category={category}>
  {image ? (
    <img src={image} alt={title} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  ) : (
    <div class="fallback" aria-hidden="true">
      <div class="ring">
        <span class="grain grain-one"></span>
        <span class="grain grain-two"></span>
        <span class="grain grain-three"></span>
      </div>
      <span class="category-stamp">{getCategory(category).title}</span>
    </div>
  )}
</div>
<style>
  .recipe-media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #e5dfd1;
    overflow: hidden;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(circle at 18% 15%, #ffffff66 0, transparent 42%),
      linear-gradient(135deg, #e9dcc2, #d7c39f);
  }

  .fallback::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.12;
    background: repeating-linear-gradient(
      120deg,
      transparent 0,
      transparent 22px,
      #786b51 23px,
      transparent 24px
    );
  }

  .ring {
    position: relative;
    display: grid;
    place-items: center;
    width: 53%;
    aspect-ratio: 1;
    border: 12px solid #f8f0df;
    box-shadow:
      0 0 0 2px #9f8d6b36,
      inset 0 0 0 2px #917d5a33,
      0 12px 35px #57432c20;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      #b86d46 0 22%,
      #e4b46c 23% 37%,
      #8a6b43 38% 43%,
      #d8a45e 44% 66%,
      #f0d59d 67%
    );
    transform: rotate(-17deg);
  }

  .grain {
    position: absolute;
    width: 27%;
    height: 6%;
    border-radius: 50%;
    background: #633d2d77;
    transform: rotate(-26deg);
  }

  .grain-one {
    top: 34%;
    left: 18%;
  }

  .grain-two {
    top: 61%;
    left: 49%;
    transform: rotate(33deg);
  }

  .grain-three {
    top: 26%;
    right: 14%;
  }

  .category-stamp {
    position: absolute;
    bottom: 14px;
    left: 14px;
    padding: 7px 12px;
    background: #fff9eac9;
    color: #554d3a;
    border: 1px solid #ffffffa8;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  [data-category='rund'] .fallback {
    filter: sepia(0.1) saturate(1.2);
  }

  [data-category='vis'] .fallback {
    filter: hue-rotate(45deg) saturate(0.65);
  }

  [data-category='bijgerechten'] .fallback {
    filter: hue-rotate(25deg) saturate(0.9);
  }

  [data-category='kip'] .fallback {
    filter: saturate(0.8) brightness(1.1);
  }

  [data-category='sauzen-en-rubs'] .fallback {
    filter: sepia(0.2) saturate(1.35) brightness(0.9);
  }
</style>
