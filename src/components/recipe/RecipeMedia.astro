---
import type { CategorySlug } from '../../data/categories';
import { getCategory } from '../../data/categories';

interface Props {
  title: string;
  category: CategorySlug;
  image?: string;
  eager?: boolean;
}
const { title, category, image, eager = false } = Astro.props;
---

<div class="recipe-media" data-category={category}>
  {image ? (
    <img src={image} alt={title} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  ) : (
    <div class="fallback" aria-hidden="true">
      <img
        class="silhouette"
        src={`/images/categories/${category}.svg`}
        alt=""
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
      <span class="category-stamp">{getCategory(category).title}</span>
    </div>
  )}
</div>
<style>
  .recipe-media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--soft);
    overflow: hidden;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(circle at 18% 15%, #fff9ef66 0, transparent 42%),
      linear-gradient(135deg, var(--media-light, #f0ce95), var(--media-dark, #ad6743));
  }

  .fallback::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.12;
    background: repeating-linear-gradient(
      120deg,
      transparent 0,
      transparent 22px,
      #613824 23px,
      transparent 24px
    );
  }

  .silhouette {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);

    width: 75%;
    max-width: 420px;
    height: 50%;

    object-fit: contain;
    object-position: center;

    opacity: 0.48;
    filter: drop-shadow(0 8px 18px rgb(35 28 25 / 0.10));
  }

  .category-stamp {
    position: absolute;
    bottom: 14px;
    left: 14px;
    padding: 7px 12px;
    background: #fff9efdf;
    color: var(--ink);
    border: 1px solid #fff9efa8;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  [data-category='rund'] {
    --media-light: #ddb18a;
    --media-dark: #8a4e34;
    --silhouette-color: #4f2617;
  }

  [data-category='vis'] {
    --media-light: #e0d1bb;
    --media-dark: #938070;
    --silhouette-color: #4f3424;
  }

  [data-category='bijgerechten'] {
    --media-light: #e4be84;
    --media-dark: #ac7a44;
    --silhouette-color: #5a331f;
  }

  [data-category='kip'] {
    --media-light: #f5d49b;
    --media-dark: #bd7c3d;
    --silhouette-color: #5a2d1a;
  }

  [data-category='sauzen-en-rubs'] {
    --media-light: #e9b577;
    --media-dark: #854a30;
    --silhouette-color: #522818;
  }

  [data-category='varken'] {
    --media-light: #e3b28f;
    --media-dark: #9d5d43;
    --silhouette-color: #572b1a;
  }
</style>
