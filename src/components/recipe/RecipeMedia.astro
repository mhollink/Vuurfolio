---
import type { CategorySlug } from '../../data/categories';
import { getCategory } from '../../data/categories';

interface Props {
  title: string;
  category: CategorySlug;
  image?: string;
  eager?: boolean;
}
const { title, category, image, eager = false } = Astro.props;
---

<div class="recipe-media" data-category={category}>
  {image ? (
    <img src={image} alt={title} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  ) : (
    <div class="fallback" aria-hidden="true">
      <div class="ring">
        <span class="grain grain-one"></span>
        <span class="grain grain-two"></span>
        <span class="grain grain-three"></span>
      </div>
      <span class="category-stamp">{getCategory(category).title}</span>
    </div>
  )}
</div>
<style>
  .recipe-media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--soft);
    overflow: hidden;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(circle at 18% 15%, #fff9ef66 0, transparent 42%),
      linear-gradient(135deg, var(--media-light, #f0ce95), var(--media-dark, #ad6743));
  }

  .fallback::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.12;
    background: repeating-linear-gradient(
      120deg,
      transparent 0,
      transparent 22px,
      #613824 23px,
      transparent 24px
    );
  }

  .ring {
    position: relative;
    display: grid;
    place-items: center;
    width: 53%;
    aspect-ratio: 1;
    border: 12px solid var(--white);
    box-shadow:
      0 0 0 2px #70412a36,
      inset 0 0 0 2px #70412a33,
      0 12px 35px #32180f33;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      #874428 0 22%,
      #d9843f 23% 37%,
      #553223 38% 43%,
      #e5a64d 44% 66%,
      #f4d29a 67%
    );
    transform: rotate(-17deg);
  }

  .grain {
    position: absolute;
    width: 27%;
    height: 6%;
    border-radius: 50%;
    background: #55322399;
    transform: rotate(-26deg);
  }

  .grain-one {
    top: 34%;
    left: 18%;
  }

  .grain-two {
    top: 61%;
    left: 49%;
    transform: rotate(33deg);
  }

  .grain-three {
    top: 26%;
    right: 14%;
  }

  .category-stamp {
    position: absolute;
    bottom: 14px;
    left: 14px;
    padding: 7px 12px;
    background: #fff9efdf;
    color: var(--ink);
    border: 1px solid #fff9efa8;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  [data-category='rund'] {
    --media-light: #ddb18a;
    --media-dark: #895035;
  }

  [data-category='vis'] {
    --media-light: #e0d1bb;
    --media-dark: #938070;
  }

  [data-category='bijgerechten'] {
    --media-light: #ebc58d;
    --media-dark: #b0814d;
  }

  [data-category='kip'] {
    --media-light: #f5d49b;
    --media-dark: #bd7c3d;
  }

  [data-category='sauzen-en-rubs'] {
    --media-light: #e9b577;
    --media-dark: #854a30;
  }
</style>
