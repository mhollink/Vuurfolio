---
interface Props {
  steps: string[];
}
const { steps } = Astro.props;
---

<section class="method" aria-labelledby="method-title">
  <h2 id="method-title">Bereiding</h2>
  <ol>
    {steps.map((step, index) => (
      <li>
        <span class="number" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </span>
        <p>{step}</p>
      </li>
    ))}
  </ol>
</section>
<style>
  h2 {
    margin: 0 0 15px;
    font-family: var(--serif);
    font-size: 2.2rem;
    font-weight: 500;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 23px 0;
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 17px;
    border-bottom: 1px solid var(--line);
  }

  .number {
    font-family: var(--serif);
    font-size: 1.5rem;
    color: var(--rust);
  }

  p {
    margin: 0;
    font-size: 1.01rem;
    line-height: 1.8;
  }
</style>
