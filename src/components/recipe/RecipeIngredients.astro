---
import type { Recipe } from '../../lib/recipes';

interface Props {
  ingredients: Recipe['data']['ingredients'];
}
const { ingredients } = Astro.props;
---

<section class="ingredients" aria-labelledby="ingredients-title">
  <h2 id="ingredients-title">Ingrediënten</h2>
  {ingredients.map((group) => (
    <div class="ingredient-group">
      {group.title && <h3>{group.title}</h3>}
      <ul>
        {group.items.map((ingredient) => (
          <li>{ingredient}</li>
        ))}
      </ul>
    </div>
  ))}
</section>
<style>
  .ingredients {
    padding: 30px;
    border-radius: 9px;
    background: var(--soft);
    align-self: start;
  }

  h2 {
    margin: 0 0 21px;
    font-family: var(--serif);
    font-size: 1.85rem;
    font-weight: 500;
  }

  .ingredient-group + .ingredient-group {
    margin-top: 28px;
  }

  h3 {
    margin: 0 0 12px;
    font-size: 0.97rem;
    font-weight: 750;
    line-height: 1.4;
  }

  ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  li {
    padding: 13px 0 13px 28px;
    position: relative;
    border-top: 1px solid var(--line);
    font-size: 0.96rem;
    line-height: 1.45;
  }

  li::before {
    content: '';
    width: 9px;
    height: 9px;
    position: absolute;
    left: 0;
    top: 19px;
    border: 2px solid var(--rust);
    border-radius: 2px;
  }
</style>
