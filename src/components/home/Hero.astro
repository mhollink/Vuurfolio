---
import type { Recipe } from '../../lib/recipes';
import { recipeUrl } from '../../lib/recipes';
import { formatMinutes } from '../../lib/time';
import RecipeMedia from '../recipe/RecipeMedia.astro';
import Icon from '../ui/Icon.astro';
interface Props {
  recipe?: Recipe;
}
const { recipe } = Astro.props;
---

<section class="hero">
  <div class="wrap hero-layout">
    <div class="copy">
      <h1 class="display">
        Goed eten begint <em>bij het vuur.</em>
      </h1>
      <p class="lead">
        Van low & slow klassiekers tot snelle gerechten voor doordeweeks. Duidelijke recepten,
        eerlijke ingrediënten en vooral veel zin om te barbecueën.
      </p>
      <div class="actions">
        <a class="button" href="/recepten/">
          Bekijk alle recepten
          <Icon name="arrow" size={19} />
        </a>
        <a class="text-link" href="/over/">
          Meer over deze site
        </a>
      </div>
    </div>
    {recipe && (
      <a
        class="spotlight"
        href={recipeUrl(recipe)}
        aria-label={`Uitgelicht recept: ${recipe.data.title}`}
      >
        <div class="spotlight-image">
          <RecipeMedia
            title={recipe.data.title}
            category={recipe.data.category}
            image={recipe.data.image}
            eager
          />
        </div>
        <div class="spotlight-content">
          <span>Uitgelicht recept</span>
          <strong>{recipe.data.title}</strong>
          <small>
            <Icon name="clock" size={15} />
            {formatMinutes(recipe.data.prepMinutes + recipe.data.cookMinutes)}
            <Icon name="arrow" size={18} />
          </small>
        </div>
      </a>
    )}
  </div>
</section>
<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: radial-gradient(ellipse at 75% 40%, var(--charcoal-soft), var(--charcoal) 75%);
    color: var(--white);
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -170px;
    left: -200px;
    width: 630px;
    height: 630px;
    border-radius: 50%;
    border: 1px solid var(--hero-ring);
    box-shadow:
      0 0 0 80px var(--hero-halo-inner),
      0 0 0 180px var(--hero-halo-outer);
    pointer-events: none;
  }

  .hero-layout {
    position: relative;
    padding-block: 86px;
    display: grid;
    grid-template-columns: 1fr 0.88fr;
    align-items: center;
    gap: min(7vw, 85px);
  }

  .copy {
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: var(--amber);
  }

  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--amber);
    border-radius: 50%;
  }

  h1 {
    margin: 0 0 26px;
    max-width: 630px;
  }

  h1 em {
    color: var(--flame);
    font-weight: 500;
  }

  .lead {
    margin: 0;
    color: var(--smoke);
  }

  .hero :global(.button) {
    background: var(--amber);
    border-color: var(--amber);
    color: var(--charcoal);
  }

  .hero :global(.button:hover) {
    background: var(--amber-hover);
    border-color: var(--amber-hover);
  }

  .actions {
    margin-top: 34px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
  }

  .text-link {
    color: var(--white);
    text-decoration-color: var(--amber);
    text-underline-offset: 5px;
    font-size: 0.91rem;
    font-weight: 700;
  }

  .small-note {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 55px;
    font-size: 0.78rem;
    color: var(--smoke);
  }

  .spotlight {
    display: block;
    position: relative;
    background: var(--white);
    color: var(--ink);
    text-decoration: none;
    border: 8px solid var(--white);
    border-radius: 9px;
    box-shadow: 0 24px 70px #100c0a66;
    transform: rotate(1deg);
    transition: transform 0.2s;
  }

  .spotlight:hover {
    transform: rotate(0deg) translateY(-3px);
  }

  .spotlight-image {
    aspect-ratio: 1.18;
    overflow: hidden;
  }

  .spotlight-image :global(.recipe-media) {
    height: 100%;
    aspect-ratio: auto;
  }

  .spotlight-content {
    display: grid;
    gap: 8px;
    padding: 24px;
  }

  .spotlight-content > span {
    color: var(--rust);
    text-transform: uppercase;
    letter-spacing: 0.13em;
    font-size: 0.68rem;
    font-weight: 800;
  }

  .spotlight-content strong {
    font-family: var(--serif);
    font-size: 1.8rem;
    font-weight: 500;
  }

  .spotlight-content small {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .spotlight-content small :global(svg:last-child) {
    margin-left: auto;
    color: var(--rust);
  }

  @media (max-width: 800px) {
    .hero-layout {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-block: 62px;
    }

    .small-note {
      margin-top: 26px;
    }

    .spotlight {
      transform: none;
      max-width: 600px;
    }
  }
</style>
