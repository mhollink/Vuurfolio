  ingredients: [
    {
      items: [
        '3 volle el Griekse yoghurt',
        '1 el mayonaise',
        '1 tl knoflookpuree',
        '1 tl kristalsuiker',
        'Zout en versgemalen zwarte peper naar smaak',
      ],
    },
  ],
  steps: [
    'Doe de Griekse yoghurt en mayonaise in een kommetje en roer tot een gladde basis.',
    'Voeg de knoflookpuree en kristalsuiker toe en meng goed door elkaar.',
    'Breng de saus op smaak met zout en versgemalen zwarte peper. Proef en pas de smaak eventueel aan.',
    'Serveer de knoflooksaus direct, bijvoorbeeld over een kapsalon of bij kip en friet. Bewaar tot het serveren in de koelkast.',
