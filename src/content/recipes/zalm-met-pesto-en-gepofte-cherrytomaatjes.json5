{
  title: 'Zalm met zelfgemaakte pesto en tomaatjes',
  description: 'Zalm van de BBQ met verse basilicumpesto. Afgedekt gegaard met cherrytomaatjes, zodat de zalm sappig blijft en de tomaatjes zacht poffen.',
  category: 'vis',
  publishedAt: '2026-11-01',
  featured: true,
  difficulty: 'Makkelijk',
  prepMinutes: 20,
  cookMinutes: 25,
  servings: 4,
