{
  title: 'Kipsaté met zelfgemaakte pindasaus',
  description: 'Sappige kipsaté van de BBQ, eenvoudig gemarineerd in ketjap en knoflook. Geserveerd met een zelfgemaakte pindasaus van Calvé pindakaas.',
  category: 'kip',
  publishedAt: '2026-11-01',
  featured: false,
  difficulty: 'Makkelijk',
